# Threads API configuration (reference for the variables the server reads)
# Get a token: https://developers.facebook.com/docs/threads/get-started
#
# The server does not read .env files itself. Put these in the "env" block of
# your MCP client config, or for local development run:
#   node --env-file=.env dist/index.js

# Required: long-lived Threads user token (valid 60 days; refresh with refresh_access_token)
THREADS_ACCESS_TOKEN=your_threads_access_token_here

# Optional: your Threads user ID (saves one /me lookup)
# THREADS_USER_ID=

# Optional: app secret, enables exchange_for_long_lived_token
# THREADS_APP_SECRET=

# Optional: only expose read tools (no publishing, deleting or scheduling)
# THREADS_READ_ONLY=true

# Optional: seconds a publish call waits for media processing (default 45)
# THREADS_PUBLISH_WAIT_SECONDS=45

# Optional: where scheduled posts are stored (default ~/.threads-mcp/scheduled-posts.json)
# THREADS_SCHEDULE_FILE=

# Optional: Graph API host (HTTPS only) and version (defaults https://graph.threads.net and v1.0)
# THREADS_API_BASE_URL=https://graph.threads.net
# THREADS_API_VERSION=v1.0
