{
  "name": "threads-mcp-server",
  "version": "6.0.0",
  "description": "MCP server for the official Meta Threads API: publish posts, carousels, polls, replies and quotes, read insights, search, and schedule posts.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "type": "module",
  "bin": {
    "threads-mcp-server": "dist/index.js",
    "threads-mcp": "dist/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "test": "node --import tsx --test \"test/**/*.test.ts\"",
    "prepublishOnly": "npm run clean && npm run build && npm test"
  },
  "keywords": [
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "threads",
    "threads-api",
    "meta",
    "social-media",
    "scheduling",
    "analytics"
  ],
  "author": "baguskto",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/server": "^2.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.3.1",
    "@types/node": "^22.20.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "files": [
    "dist/**/*",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=20.12"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/baguskto/threads-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/baguskto/threads-mcp/issues"
  },
  "homepage": "https://github.com/baguskto/threads-mcp#readme"
}
